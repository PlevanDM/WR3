BOT_TOKEN=
ADMIN_TG_IDS=

REMONLINE_API_KEY=
REMONLINE_BASE_URL=https://api.roapp.io
REMONLINE_ORDER_URL=https://web.roapp.io/orders/{id}

GALLERY_CHAT_ID=

# Local SQLite (default). To use Postgres, set DB_URL or POSTGRES_* vars.
DB_URL=sqlite+aiosqlite:///./data/warranty.db

# Redis disabled by default (MemoryStorage for FSM). Enable if you run Redis locally.
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

POLL_INTERVAL_SEC=60
SLA_STALE_DAYS=7
LOG_LEVEL=INFO
TZ=Europe/Kyiv
